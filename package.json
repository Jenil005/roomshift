{
  "name": "roomshift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "playwright test",
    "markers": "node ar/scripts/generate-markers.mjs",
    "prepare:room": "node ar/scripts/prepare-room-runtime.mjs",
    "predev": "npm run prepare:room",
    "prebuild": "npm run prepare:room",
    "prepreview": "npm run prepare:room",
    "check:room-runtime": "node ar/scripts/check-room-runtime.mjs"
  },
  "dependencies": {
    "@8thwall/engine-binary": "1.0.0",
    "jsqr": "^1.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "0.174.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "qrcode": "^1.5.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
